        {
          "name": "verify-otp",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "// Try common token field names",
                  "const token =",
                  "    res.token ||",
                  "    res.access_token ||",
                  "    res.accessToken ||",
                  "    (res.data && (res.data.token || res.data.access_token || res.data.accessToken)) ||",
                  "    null;",
                  "",
                  "if (token) {",
                  "    pm.environment.set(\"token\", token);",
                  "    console.log(\"Token saved to environment:\", token);",
                  "} else {",
                  "    console.warn(\"Token not found in response. Check the response structure.\", res);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
